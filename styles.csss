:root {
  --accent: #5a7fa8;
  --accent-light: #e7edf5;
  --text-dark: #222;
  --text-light: #555;
  --bg-light: #f5f7fa;
  --white: #ffffff;
  --shadow: 0 4px 20px rgba(0,0,0,0.08);
  --transition: 0.25s ease;
  --radius: 14px;
  --max-width: 900px;
}

body {
  margin: 0;
  padding: 0;
  font-family: 'Inter', sans-serif;
  background: var(--bg-light);
  color: var(--text-dark);
}

nav {
  background: var(--white);
  border-bottom: 1px solid #ddd;
  padding: 14px 40px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 1000;
}

nav .logo {
  font-weight: 600;
  font-size: 20px;
  color: var(--accent);
}

nav ul {
  list-style: none;
  display: flex;
  gap: 28px;
  margin: 0;
  padding: 0;
}

nav ul li a {
  text-decoration: none;
  color: var(--text-dark);
  font-weight: 500;
  transition: var(--transition);
}

nav ul li a:hover {
  color: var(--accent);
}

.container {
  max-width: var(--max-width);
  margin: 60px auto;
  background: var(--white);
  padding: 45px;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

h1 {
  text-align: center;
  font-weight: 600;
  margin-bottom: 20px;
  color: var(--text-dark);
}

p {
  color: var(--text-light);
  line-height: 1.7;
  font-size: 16px;
}


img {
  display: block;
  max-width: 100%;
  border-radius: 10px;
  margin: 30px auto;
  box-shadow: 0 2px 12px rgba(0,0,0,0.12);
  transition: var(--transition);
}

/* subtle transform effect */
img:hover {
  transform: scale(1.02);
  filter: brightness(1.05);
}

a.button {
  display: inline-block;
  margin-top: 25px;
  text-decoration: none;
  color: var(--white);
  background: var(--accent);
  padding: 12px 18px;
  border-radius: 6px;
  transition: var(--transition);
}

a.button:hover {
  background: #4a6b8f;
}


footer {
  background: var(--white);
  border-top: 1px solid #ddd;
  padding: 20px;
  text-align: center;
  color: var(--text-light);
  margin-top: 60px;
}


@media (max-width: 700px) {
  nav {
    padding: 14px 20px;
  }

  nav ul {
    gap: 16px;
  }

  .container {
    padding: 30px;
    margin: 30px 12px;
  }
}
